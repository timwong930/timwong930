{
  "name": "Tim Wong GitHub Profile",
  "surface": "github-profile-readme",
  "mode": "experience",
  "palette": {
    "light": {
      "bg": "#ffffff",
      "ink": "#24292f",
      "muted": "#59636e",
      "rule": "#d1d9e0",
      "accent": "#4d6548",
      "rust": "#895640",
      "surface": "#f6f8fa",
      "sub": "#7b8378"
    },
    "dark": {
      "bg": "#0d1117",
      "ink": "#e6edf3",
      "muted": "#a1aab4",
      "rule": "#30363d",
      "accent": "#b8ceb0",
      "rust": "#d9a389",
      "surface": "#161b22",
      "sub": "#788879"
    }
  },
  "typography": {
    "display": "Georgia, Times New Roman, serif",
    "body": "Arial, Helvetica, sans-serif"
  },
  "radii": {
    "panel": "5px"
  },
  "motion": {
    "implementation": "Native SVG SMIL animations in external image files",
    "sectionsAnimated": [
      "banner",
      "process",
      "footer"
    ],
    "sectionsStatic": [
      "focus"
    ],
    "staticFallback": "Separate -static.svg variants via prefers-reduced-motion picture sources",
    "noUnanchoredFocusMotion": true
  },
  "mobileBreakpoint": "640px",
  "theme": {
    "selection": "README picture prefers-color-scheme sources",
    "lightBackground": "#ffffff",
    "darkBackground": "#0d1117",
    "cacheStrategy": "Fresh v5 file paths, animated and static, while keeping v4 focus static"
  }
}
